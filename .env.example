# App
PORT=3000
NODE_ENV=development

# Database (Docker Compose defaults)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/url_shortener?schema=public"
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=url_shortener

# Redis (Docker Compose defaults)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis

# App base URL (used to build short URLs)
APP_URL=http://localhost:3000

# JWT (phase 2)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_REFRESH_EXPIRES_IN=7d
